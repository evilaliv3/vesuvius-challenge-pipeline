+class _WeightedQueue:
+    """Draw with replacement, weight proportional to patch count ** power (power 0 is uniform)."""
+
+    def __init__(self, values: Sequence, weights: Sequence[float], *, seed: int) -> None:
+        self._values, self._weights = list(values), list(weights)
+        self._rng = random.Random(int(seed))
+        self.recycles = 0
+
+    def pop(self):
+        return self._rng.choices(self._values, self._weights)[0]
+
