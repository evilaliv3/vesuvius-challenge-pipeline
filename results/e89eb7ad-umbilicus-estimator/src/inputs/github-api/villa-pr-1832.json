  "title": "spiral-fitting: a mesh node outside the scroll, or not finite, is not surface",
  "user": {
    "login": "evilaliv3",
    "id": 217034,
    "node_id": "MDQ6VXNlcjIxNzAzNA==",
    "avatar_url": "https://avatars.githubusercontent.com/u/217034?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/evilaliv3",
    "html_url": "https://github.com/evilaliv3",
    "followers_url": "https://api.github.com/users/evilaliv3/followers",
    "following_url": "https://api.github.com/users/evilaliv3/following{/other_user}",
    "gists_url": "https://api.github.com/users/evilaliv3/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/evilaliv3/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/evilaliv3/subscriptions",
    "organizations_url": "https://api.github.com/users/evilaliv3/orgs",
    "repos_url": "https://api.github.com/users/evilaliv3/repos",
    "events_url": "https://api.github.com/users/evilaliv3/events{/privacy}",
    "received_events_url": "https://api.github.com/users/evilaliv3/received_events",
