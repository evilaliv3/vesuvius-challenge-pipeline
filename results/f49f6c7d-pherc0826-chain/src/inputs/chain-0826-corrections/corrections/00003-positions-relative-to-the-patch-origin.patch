         paperPoint paperSheet[SHEET_SIZE][SHEET_SIZE];     // .pos only, 12 bytes per point
         // Velocity and vector field, taken out of paperPoint so the hot loop does not waste
         // bandwidth: of the eight neighbours it reads the position and nothing else.
+        // POSITIONS ARE RELATIVE to the patch origin.
+        // Absolute positions run from 3000 to 20000 voxels, where the step of a float32 is
+        // between 2.4e-4 and 2.0e-3 voxels. The relaxation updates them in small increments,
+        // a hundred iterations at a time: an increment below that step does not round, it
+        // DISAPPEARS. Measured 2026-09-13 over g 300: 12,711,665 vanished steps out of
+        // 557,554,102, that is 2.28 per cent.
+        //
+        // A patch is a few hundred voxels across, so holding the positions relative to its
+        // origin brings the step to 3.1e-5: sixty-four times better exactly where it was
+        // worst. The origin is a double, fixed at the seed and never changed again.
+        // With this, the same measurement gives FORTY vanished steps out of 578,078,715.
+        //
+        // Differences between positions are unchanged, because the origin cancels, so the
+        // hot force loop is untouched. Only the sites needing an ABSOLUTE position convert.
+        double patchOrigin[3];
+        inline Vec3 AbsPos(int x, int y) const
+        {
+          return Vec3((float)(patchOrigin[0] + (double)paperSheet[x][y].pos.x),
+                      (float)(patchOrigin[1] + (double)paperSheet[x][y].pos.y),
+                      (float)(patchOrigin[2] + (double)paperSheet[x][y].pos.z));
+        }
+        inline point RelOf(double ax, double ay, double az) const
+        {
+          return point((float)(ax-patchOrigin[0]),(float)(ay-patchOrigin[1]),(float)(az-patchOrigin[2]));
+        }
         point velSheet[SHEET_SIZE][SHEET_SIZE];
         point vfSheet[SHEET_SIZE][SHEET_SIZE];
 				
